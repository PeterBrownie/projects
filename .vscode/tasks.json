{
	// "Dev Server" is run by the Dev Server button in the status bar
	// (local.dev-server-button extension), or from Terminal > Run Task.
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Dev Server",
			"detail": "http://localhost:8000/",
			"type": "process",
			"command": "python3",
			"args": ["${workspaceFolder}/.vscode/devserver.py", "8000"],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
		}
	]
}
